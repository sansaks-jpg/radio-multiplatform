# =============================================================================
# Gaul FM Semarang — Mobile App Environment Variables
# =============================================================================

# 1. Supabase Connection (Optional — app falls back to bundled mock data & local demo auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Audio Live Stream (Icecast HTTP progressive stream)
# Fallback defaults to: http://27.50.19.173:9000/gaulfm.m3u
EXPO_PUBLIC_STREAM_URL=http://27.50.19.173:9000/gaulfm.m3u

# 3. Visual Radio Stream (MediaMTX WebRTC / WHEP + HLS Fallback)
EXPO_PUBLIC_VISUAL_STREAM_RTMP_URL=rtmp://40.81.231.250:1935/gaulfm_webrtc
EXPO_PUBLIC_VISUAL_STREAM_WHEP_URL=http://40.81.231.250:8889/gaulfm_webrtc/whep
EXPO_PUBLIC_VISUAL_STREAM_HLS_URL=http://40.81.231.250:8888/gaulfm_webrtc/index.m3u8

# 4. Admin Web API & Live Chat Sync (REST & Realtime Comments)
EXPO_PUBLIC_API_URL=http://40.81.231.250:3001

