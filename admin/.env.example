# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sheets Sync (Optional - for auto sync listener registrations)
# GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WEBHOOK_SECRET=your-webhook-secret

# Optional HTTPS HLS endpoint for an HTTPS admin deployment.
NEXT_PUBLIC_VISUAL_HLS_URL=http://40.81.231.250:8888/gaulfm/index.m3u8

# YouTube account management via OAuth 2.0 (server-only; never prefix with NEXT_PUBLIC_)
# YOUTUBE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_OAUTH_CLIENT_SECRET=store-this-only-on-the-server
# Development callback currently used on Azure:
# YOUTUBE_OAUTH_REDIRECT_URI=https://admingaul.duckdns.org/api/youtube/oauth/callback
# Generate with: openssl rand -base64 32
# YOUTUBE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Optional. Defaults to admin/.data/youtube-oauth.json.enc
